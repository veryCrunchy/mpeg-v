PORT=3000
HOST=127.0.0.1
# Required. Use a long random secret shared with the bot and web gateway.
API_TOKEN=
# Existing optional bot conversion metadata logging.
ENV=development
API=
# Optional private translation snapshot. Empty means memory-only tracking.
# Use a persistent volume or ignored .data/ directory, with one worker per file.
TRANSLATION_SESSIONS_FILE=
# SQLite preferences database. Empty uses apps/serve/.data/settings.sqlite.
# Mount its containing directory as a persistent volume in production.
SETTINGS_DATABASE=
