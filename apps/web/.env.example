# Public application ID, never the bot token.
NUXT_PUBLIC_DISCORD_CLIENT_ID=
# Optional custom install URL configured in the Discord Developer Portal.
NUXT_PUBLIC_DISCORD_INSTALL_URL=
# Server-only Discord OAuth secret.
NUXT_DISCORD_CLIENT_SECRET=
# Optional legacy gateway settings. Browser conversion does not use this worker.
# Internal worker URL and its API_TOKEN. These never enter the browser bundle.
NUXT_CONVERSION_URL=http://127.0.0.1:3000
NUXT_CONVERSION_TOKEN=
# Private settings service. Only preference values and verified Discord IDs are sent.
NUXT_PREFERENCES_URL=http://127.0.0.1:3000
NUXT_PREFERENCES_TOKEN=
