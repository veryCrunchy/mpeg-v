# discord token for your bot, you can get it from: https://discord.com/developers/applications
CLIENT_TOKEN=""

# endpoints (do NOT add a trailing /, ex: "http://127.0.0.1:3000")
API=""
STREAM=""

# endpoints authorization; keep it the same across all apps
API_TOKEN=""

# live translation websocket; defaults to ws://127.0.0.1:8080/ws/transcribe
WHISPER_WS="wss://whisper.obiente.cloud/ws/transcribe"
# legacy alias also supported by the bot:
# TRANSLATION_WS="wss://whisper.obiente.cloud/ws/transcribe"

# public translate frontend; used for Discord caption session links
TRANSLATE_PUBLIC_URL="https://translate.obiente.org"

# optional: dump outbound 16k mono utterances to WAV files for debugging
# example: /data/voice-debug
VOICE_TRANSLATE_DEBUG_DUMP_DIR=""

# voice translation sessions are persisted by the serve app, not the bot.
# Set TRANSLATION_SESSIONS_FILE on apps/serve if you want the bot to resume
# existing voice translation sessions after restarts.
