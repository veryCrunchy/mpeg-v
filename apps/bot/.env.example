# live translation websocket; defaults to ws://127.0.0.1:8080/ws/transcribe
WHISPER_WS="wss://whisper.obiente.cloud/ws/transcribe"

# public translate frontend; used for Discord caption session links
TRANSLATE_PUBLIC_URL="https://translate.obiente.cloud"
